{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"], "allowJs": true, "checkJs": false,
    "strict": true, "noImplicitAny": false, "skipLibCheck": true, "noEmit": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"], "@sky/*": ["../../shared/*"] },
    "types": ["vite/client"]
  },
  "include": ["src/components/sky-twin/**/*.vue", "src/composables/useSkyWorkspace.ts", "src/views/sky-twin/**/*.vue"]
}
